# CORS allowed origins (comma-separated)
LUNARSIGHT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://lunarsight.vercel.app

# Persistent SQLite DB & disk cache paths
LUNARSIGHT_CACHE_DIR=./cache
LUNARSIGHT_DB_PATH=./cache/lunarsight.db

# Optional AI Advisor (OpenAI-compatible endpoint). Leave key empty for deterministic-only mode.
LUNARSIGHT_LLM_API_KEY=
LUNARSIGHT_LLM_BASE_URL=https://api.openai.com/v1
LUNARSIGHT_LLM_MODEL=gpt-4o-mini
